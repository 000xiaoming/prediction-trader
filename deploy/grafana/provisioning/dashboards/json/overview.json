      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT bucket AS time, close AS value, instrument AS metric FROM price_candles_1m WHERE venue = 'binance' AND $__timeFilter(bucket) ORDER BY bucket", "refId": "A"}],
      "title": "Binance 1m Close by Symbol (Recorded History)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 26},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT c.bucket AS time, c.close AS value, concat(c.instrument, ' ', coalesce(q.outcome, '')) AS metric FROM price_candles_1m c LEFT JOIN market_quotes q ON q.token_id = c.instrument WHERE c.venue = 'polymarket' AND $__timeFilter(c.bucket) ORDER BY c.bucket", "refId": "A"}],
      "title": "Polymarket 1m Mid-Price Candles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 35},
      "id": 9,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT marked_pnl_usd FROM replay_runs ORDER BY completed_at DESC LIMIT 1", "refId": "A"}],
      "title": "Latest Replay Marked PnL",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 35},
      "id": 10,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT max_drawdown_usd FROM replay_runs ORDER BY completed_at DESC LIMIT 1", "refId": "A"}],
      "title": "Latest Replay Max Drawdown",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 35},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT fill_count FROM replay_runs ORDER BY completed_at DESC LIMIT 1", "refId": "A"}],
      "title": "Latest Replay Fills",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 43},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT point_time AS time, equity_usd AS value FROM replay_equity_points WHERE run_id = (SELECT id FROM replay_runs ORDER BY completed_at DESC LIMIT 1) ORDER BY point_time", "refId": "A"}],
      "title": "Latest Replay Marked Equity Curve",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 53},
      "id": 13,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT coalesce(sum(realized_pnl_usd), 0) AS realized_pnl_usd FROM replay_fill_settlements WHERE run_id = (SELECT id FROM replay_runs ORDER BY completed_at DESC LIMIT 1)", "refId": "A"}],
      "title": "Latest Replay Realized PnL",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 53},
      "id": 14,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT coalesce(avg(CASE WHEN won THEN 1.0 ELSE 0.0 END), 0) AS win_rate FROM replay_fill_settlements WHERE run_id = (SELECT id FROM replay_runs ORDER BY completed_at DESC LIMIT 1)", "refId": "A"}],
      "title": "Latest Replay Win Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 53},
      "id": 15,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT count(*) AS settled_fills FROM replay_fill_settlements WHERE run_id = (SELECT id FROM replay_runs ORDER BY completed_at DESC LIMIT 1)", "refId": "A"}],
      "title": "Latest Replay Settled Fills",
      "type": "stat"
    }
