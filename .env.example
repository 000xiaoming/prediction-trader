TRADING_MODE=paper
# Change this single selector; restart trader after changing it.
# Also available: polymarket_btc_15m, polymarket_eth_5m
TRADING_PROFILE=polymarket_btc_5m
# Blank enables only the primary. Comma-separated extras share collectors.
ENABLED_TRADING_PROFILES=polymarket_btc_5m,polymarket_btc_15m,polymarket_eth_5m
PROFILE_BACKTESTS_ENABLED=true
PROFILE_BACKTEST_INTERVAL_SECONDS=300
PROFILE_BACKTEST_LOOKBACK_HOURS=24
PAPER_LEDGER_PATH=data/paper-ledger.sqlite3
PAPER_INITIAL_CASH=1000
POLYMARKET_DISCOVERY_ENABLED=true
# Asset, slug and feed symbols derive from TRADING_PROFILE.
POLYMARKET_DISCOVERY_INTERVAL_SECONDS=60
POLYMARKET_DISCOVERY_PAGE_SIZE=100
POLYMARKET_WEBSOCKET_ENABLED=true
POLYMARKET_WEBSOCKET_REFRESH_SECONDS=15
BINANCE_REFERENCE_ENABLED=true
BINANCE_PERSIST_INTERVAL_SECONDS=1
CANDLE_REFRESH_SECONDS=10
CROSS_VENUE_LOOKBACK_SECONDS=60
CROSS_VENUE_MIN_BTC_MOVE=0.0005
CROSS_VENUE_PROBABILITY_SENSITIVITY=25
REPLAY_ORDER_LATENCY_MS=250
REPLAY_MAX_FILL_WAIT_MS=2000
REPLAY_SLIPPAGE_BPS=10
REPLAY_NOTIONAL_USD=2
SETTLEMENT_SYNC_ENABLED=true
SETTLEMENT_SYNC_INTERVAL_SECONDS=60
POLYMARKET_RTDS_ENABLED=true
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_CHAINLINK_TWAP_WINDOW_SECONDS=60
INDICATOR_HOST=0.0.0.0
INDICATOR_PORT=8080
INDICATOR_CACHE_TTL_SECONDS=0.5
INDICATOR_MAX_REFERENCE_AGE_SECONDS=5
INDICATOR_MAX_QUOTE_AGE_SECONDS=5
INDICATOR_OPENING_TOLERANCE_SECONDS=2
# Optional advisory JSON; {symbol} expands to btc-usd or eth-usd.
# Example: RESEARCH_CONTEXT_PATH=/research/{symbol}.json
RESEARCH_CONTEXT_PATH=
# Optional read-only producer run/result directory; evidence timestamps are mandatory.
TRADINGAGENTS_RESEARCH_DIR=
LOG_LEVEL=INFO
METRICS_HOST=0.0.0.0
METRICS_PORT=8000
POSTGRES_PASSWORD=local-paper-only
DATABASE_URL=postgresql+psycopg://prediction:local-paper-only@postgres:5432/prediction
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-now
MAX_MARKET_EXPOSURE_USD=10
MAX_TOTAL_EXPOSURE_USD=25
MAX_DAILY_LOSS_USD=10
MAX_SIGNAL_AGE_SECONDS=3
MIN_NET_EDGE=0.02
DEFAULT_TARGET_NOTIONAL_USD=2
